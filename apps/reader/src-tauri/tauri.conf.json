{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hamesh",
  "version": "0.0.0",
  "identifier": "app.hamesh.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Hāmesh",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' blob: data:; connect-src https: http: ipc: http://ipc.localhost; frame-src blob:; media-src blob:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub",
          "pdf"
        ],
        "name": "Book",
        "description": "EPUB or PDF book",
        "role": "Viewer",
        "mimeType": "application/octet-stream"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
